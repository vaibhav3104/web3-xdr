# ============================================================================
# Sentinel3 - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For production, use secrets management (e.g., GCP Secret Manager).
# ============================================================================


# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# PostgreSQL credentials and database name
POSTGRES_USER=xdr
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=web3_xdr

# Connection settings (used by Docker services)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ENABLED=true

# Full connection string (constructed from above; used by API and Worker)
DATABASE_URL=postgresql://xdr:your-postgres-password@postgres:5432/web3_xdr

# Alternative credential names (used by some modules)
# DB_USER=xdr
# DB_PASSWORD=your-postgres-password
# DB_NAME=web3_xdr

# Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_BATCH_SIZE=100

# Cloud SQL instance connection (GCP only)
# CLOUDSQL_INSTANCE=project:region:instance

# SQL query logging (set to true for debugging)
# SQL_ECHO=false


# ============================================================================
# Redis
# ============================================================================

# Redis URL for caching, shared state, and pub/sub between API and Worker
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Redis connection pool
# REDIS_MAX_CONNECTIONS=50

# Event and correlation TTLs
# EVENT_TTL_HOURS=72
# CORRELATION_WINDOW_MINUTES=30


# ============================================================================
# RPC Endpoints (Blockchain)
# ============================================================================
# Public endpoints have rate limits (~25 req/s).
# For production, use Infura, Alchemy, or QuickNode.

ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com

# Additional chain RPC endpoints (optional)
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# OP_RPC_URL=https://optimism-rpc.publicnode.com
# BASE_RPC_URL=https://base-rpc.publicnode.com
# AVAX_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com

# Short-form aliases (used by bytecode_collector)
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# ARB_RPC_URL=https://arbitrum-one-rpc.publicnode.com

# Infura fallback RPC
# INFURA_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# RPC health and resilience tuning
# RPC_TIMEOUT=10
# RPC_MAX_RETRIES=3
# RPC_MAX_BACKOFF=60
# RPC_UNHEALTHY_COOLDOWN=300
# RPC_HEALTH_CHECK_INTERVAL=60


# ============================================================================
# API Keys & External Services
# ============================================================================

# Premium RPC provider API keys (optional)
# INFURA_API_KEY=your-infura-api-key
# COINGECKO_API_KEY=your-coingecko-api-key

# AI/LLM API keys
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# USE_AI_API=false

# Twitter/X verification
# TWITTER_BEARER_TOKEN=your-twitter-bearer-token


# ============================================================================
# Alerting & Notifications
# ============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram channel/chat ID to send alerts to
TELEGRAM_CHANNEL_ID=
# Alternate Telegram chat ID env var (used by some modules)
# TELEGRAM_CHAT_ID=

# Slack incoming webhook URL for alert notifications
SLACK_WEBHOOK_URL=

# Email (SMTP)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# ALERT_EMAIL_FROM=sentinel3@yourdomain.com
# ALERT_EMAIL_TO=oncall@yourdomain.com,security@yourdomain.com

# PagerDuty
# PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key
# PAGERDUTY_API_KEY=your-pagerduty-api-key


# ============================================================================
# Security & Authentication
# ============================================================================

# Secret key for signing JWT tokens (required in production - use a long random string)
JWT_SECRET_KEY=your-jwt-secret-key-change-me

# API key for admin endpoints (full read/write access)
ADMIN_API_KEY=your-admin-api-key

# API key for read-only endpoints
READONLY_API_KEY=your-readonly-api-key

# Dynamic user accounts: XDR_USER_<username>=<password>:<role>
# XDR_USER_alice=SecurePass1:admin
# XDR_USER_bob=SecurePass2:operator

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Maintenance mode
# ENABLE_MAINTENANCE_ENDPOINTS=false
# MAINTENANCE_TOKEN=your-maintenance-token


# ============================================================================
# Rate Limiting
# ============================================================================

# Enable or disable rate limiting (default: true)
ENABLE_RATE_LIMITING=true

# Maximum requests per minute per client
RATE_LIMIT_RPM=120

# Maximum requests per hour per client
RATE_LIMIT_RPH=3000

# Burst limit
# RATE_LIMIT_BURST=20


# ============================================================================
# Feature Flags
# ============================================================================

# Enable transaction graph analysis
GRAPH_ENABLED=true

# Enable ML-based anomaly detection
ML_DETECTION_ENABLED=true

# Enable continuous model retraining on new data
CONTINUOUS_LEARNING_ENABLED=true

# Enable request logging middleware (default: true)
ENABLE_REQUEST_LOGGING=true

# Enable runtime security plane
# RUNTIME_ENABLED=false

# Auto-start contract scanner on worker boot
# AUTO_START_SCANNER=false
# SCANNER_CHAINS=ethereum,polygon,arbitrum


# ============================================================================
# Worker Settings
# ============================================================================

# How often the worker polls for new blocks (seconds)
POLL_INTERVAL_SECONDS=2.0

# Number of transactions to process per batch
BATCH_SIZE=10

# Timeout for processing a single transaction (seconds)
PROCESSING_TIMEOUT_SECONDS=5.0

# Worker health check port
# WORKER_HEALTH_PORT=8081

# Optional: restrict worker to specific chains (comma-separated)
# WORKER_CHAINS=ethereum,polygon,arbitrum

# Worker metrics endpoint (for API to query)
# WORKER_METRICS_URL=http://worker:8081/metrics

# Mempool source for runtime security plane
# MEMPOOL_SOURCE=rpc
# BLOXROUTE_AUTH_HEADER=your-bloxroute-auth-header


# ============================================================================
# ML / AI Configuration
# ============================================================================

# ML model type: mlp, cnn, transformer, ensemble
# ML_MODEL_TYPE=mlp

# ML inference device: cpu, cuda
# ML_DEVICE=cpu

# Path to pre-trained model file
# ML_MODEL_PATH=data/models/deep_transformer.pt

# GCS bucket for model artifacts
# ML_MODEL_BUCKET=your-gcs-bucket

# Vertex AI endpoint (GCP managed inference)
# VERTEX_AI_ENDPOINT=your-vertex-endpoint

# GCP project and region (for Vertex AI and Cloud SQL)
# GCP_PROJECT=your-gcp-project
# GCP_REGION=us-central1


# ============================================================================
# Graph Database (Neo4j)
# ============================================================================

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE=neo4j


# ============================================================================
# Runtime Security / Simulation
# ============================================================================

# Runtime auto-action (pause contract on threat detection)
# RUNTIME_AUTO_ACTION_ENABLED=false
# RUNTIME_AUTO_ACTION_MIN_CONFIDENCE=0.85
# RUNTIME_ACTION_COOLDOWN_SECONDS=300

# Per-chain and per-protocol simulation budgets (max simulations/minute)
# RUNTIME_PER_CHAIN_SIM_BUDGET=100
# RUNTIME_PER_PROTOCOL_SIM_BUDGET=50

# Comma-separated list of critical contract addresses for priority simulation
# RUNTIME_CRITICAL_CONTRACTS=0x...,0x...


# ============================================================================
# Guardian / Response
# ============================================================================

# Signer type: local, kms
# SIGNER_TYPE=local
# GUARDIAN_PRIVATE_KEY=your-guardian-private-key

# Cloud KMS signing (GCP/AWS)
# KMS_KEY_ID=your-kms-key-id
# KMS_PROVIDER=gcp
# KMS_REGION=us-central1


# ============================================================================
# Correlation & Detection Rules
# ============================================================================

# Cross-chain correlation
# CORRELATION_WINDOW_MINUTES=30
# AMOUNT_TOLERANCE_PERCENT=1.0
# ORPHAN_CHECK_DELAY_SECONDS=60
# MIN_ALERT_AMOUNT_USD=1000

# Rule feedback loop (auto-disable noisy rules)
# FEEDBACK_WINDOW_HOURS=168
# FEEDBACK_FP_THRESHOLD=0.8
# FEEDBACK_MIN_SAMPLES=10
# FEEDBACK_AUTO_DISABLE_FP=true
# FEEDBACK_COOLDOWN_HOURS=24

# Spike detection
# SPIKE_WINDOW_SECONDS=300
# SPIKE_THRESHOLD=5.0
# SPIKE_COOLDOWN_SECONDS=600


# ============================================================================
# Data Retention
# ============================================================================

# EVENT_RETENTION_DAYS=90
# INCIDENT_RETENTION_DAYS=365
# RETENTION_INTERVAL_HOURS=24


# ============================================================================
# Queue / Event Bus
# ============================================================================

# QUEUE_MAX_SIZE=10000
# QUEUE_DROP_POLICY=oldest
# DLQ_MAX_SIZE=1000
# PENDING_RECOVERY_INTERVAL=60
# MAX_RETRIES=3


# ============================================================================
# Telemetry / OpenTelemetry
# ============================================================================

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=sentinel3
# OTEL_TRACES_SAMPLER_ARG=1.0
# APP_VERSION=2.0.0
# HEARTBEAT_INTERVAL=60


# ============================================================================
# Verification
# ============================================================================

# Sentinel3 API endpoint for exploit tracker
# SENTINEL3_API=http://localhost:8000


# ============================================================================
# App Settings
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment name: development, staging, production
ENVIRONMENT=development

# Server port
# PORT=8000

# Debug mode (enables verbose logging)
# DEBUG=false

# Uvicorn worker count
# UVICORN_WORKERS=1


# ============================================================================
# Monitoring & Admin UIs (optional)
# ============================================================================

# pgAdmin login email
PGADMIN_EMAIL=admin@xdr.local

# pgAdmin login password
PGADMIN_PASSWORD=your-pgadmin-password

# Grafana admin password
GRAFANA_PASSWORD=your-grafana-password
