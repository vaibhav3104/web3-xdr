# ============================================================================
# Sentinel3 - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For production, use secrets management (e.g., GCP Secret Manager).
# ============================================================================


# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# PostgreSQL credentials and database name
POSTGRES_USER=xdr
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=web3_xdr

# Connection settings (used by Docker services and direct connections)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ENABLED=true

# Full connection string (used by API, Worker, and Alembic migrations)
# Takes precedence over individual POSTGRES_* vars when set.
DATABASE_URL=postgresql://xdr:your-postgres-password@localhost:5432/web3_xdr

# Alternative credential names (used by some modules alongside POSTGRES_*)
# DB_USER=xdr
# DB_PASSWORD=your-postgres-password
# DB_NAME=web3_xdr

# Connection pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# Batch size for bulk DB writes (shared_state, sync_service)
DB_BATCH_SIZE=100

# Database health monitor interval in seconds (API startup)
DB_HEALTH_CHECK_INTERVAL=30

# Cloud SQL instance connection (GCP only — enables Unix socket connector)
# CLOUDSQL_INSTANCE=project:region:instance

# SQL query logging (set to true for debugging)
# SQL_ECHO=false


# ============================================================================
# Redis
# ============================================================================

# Redis URL for caching, shared state, pub/sub, and event bus
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Redis connection pool max connections
# REDIS_MAX_CONNECTIONS=10

# Event TTL in Redis (hours)
# EVENT_TTL_HOURS=24

# Default cross-chain correlation window in Redis (minutes)
# CORRELATION_WINDOW_MINUTES=30


# ============================================================================
# RPC Endpoints (Blockchain)
# ============================================================================
# Public endpoints have rate limits (~25 req/s).
# For production, use Infura, Alchemy, or QuickNode.

ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com

# Additional chain RPC endpoints (optional)
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# OP_RPC_URL=https://mainnet.optimism.io
# BASE_RPC_URL=https://mainnet.base.org
# AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Short-form aliases (used by bytecode_collector and auto_collector)
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# Infura fallback RPC (used when chain-specific URL is not set)
# INFURA_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# RPC resilience tuning (robust_provider / robust_non_evm)
# RPC_TIMEOUT=30.0
# RPC_MAX_RETRIES=3
# RPC_MAX_BACKOFF=120
# RPC_UNHEALTHY_COOLDOWN=60
# RPC_HEALTH_CHECK_INTERVAL=30


# ============================================================================
# Security & Authentication
# ============================================================================

# Secret key for signing JWT tokens (required in production - use a long random string)
# In development, a random per-process secret is generated if left empty.
JWT_SECRET_KEY=your-jwt-secret-key-change-me

# API key for admin endpoints (full read/write access)
ADMIN_API_KEY=your-admin-api-key

# API key for read-only endpoints
READONLY_API_KEY=your-readonly-api-key

# User accounts (REQUIRED -- no demo/default users are loaded)
# Format: XDR_USER_<username>=<password>:<role>
# Roles: admin, operator, viewer
# At least one admin user must be configured.
XDR_USER_ADMIN=ChangeMe1:admin
# XDR_USER_alice=SecurePass1:operator
# XDR_USER_bob=SecurePass2:viewer

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Maintenance mode (admin-only diagnostic endpoints)
# ENABLE_MAINTENANCE_ENDPOINTS=false
# MAINTENANCE_TOKEN=your-maintenance-token


# ============================================================================
# Rate Limiting
# ============================================================================

# Enable or disable rate limiting middleware (default: true)
ENABLE_RATE_LIMITING=true

# Maximum requests per minute per client
RATE_LIMIT_RPM=120

# Maximum requests per hour per client
RATE_LIMIT_RPH=3000

# Burst limit (requests allowed in a single burst)
# RATE_LIMIT_BURST=20


# ============================================================================
# Alerting — Telegram
# ============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram channel/chat ID to send alerts to
TELEGRAM_CHANNEL_ID=
# Alternate chat ID (used by alert_notifier module)
# TELEGRAM_CHAT_ID=


# ============================================================================
# Alerting — Slack
# ============================================================================

# Slack incoming webhook URL for alert notifications
SLACK_WEBHOOK_URL=


# ============================================================================
# Alerting — Email (SMTP / SendGrid)
# ============================================================================

# SMTP server settings
# SMTP_SERVER=smtp.gmail.com
# SMTP_HOST=smtp.gmail.com        # Alternative name used by email_alerter
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# ALERT_EMAIL_FROM=sentinel3@yourdomain.com
# ALERT_EMAIL_TO=oncall@yourdomain.com,security@yourdomain.com

# Alternative names used by email_alerter module
# ALERT_FROM_EMAIL=sentinel3@alerts.local
# ALERT_TO_EMAILS=oncall@yourdomain.com,security@yourdomain.com

# SendGrid API key (alternative to SMTP)
# SENDGRID_API_KEY=your-sendgrid-api-key


# ============================================================================
# Alerting — PagerDuty
# ============================================================================

# PagerDuty Events API v2 routing key (for incident creation)
# PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# PagerDuty REST API key (for advanced integrations)
# PAGERDUTY_API_KEY=your-pagerduty-api-key


# ============================================================================
# API Keys — AI / LLM
# ============================================================================

# Google Gemini API key (free tier available; primary LLM backend)
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key           # Fallback for Gemini

# Anthropic Claude API key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API key (used by AI analyzer)
# OPENAI_API_KEY=your-openai-api-key

# Enable AI API usage in analyzer (default: false)
# USE_AI_API=false

# LLM model selection
# GEMINI_MODEL=gemini-2.0-flash
# LLM_MODEL=claude-sonnet-4-20250514          # Anthropic model ID
# LLM_MAX_TOKENS=1024

# LLM rate limiting and circuit breaker
# LLM_RPM_LIMIT=30                             # Max LLM requests per minute
# LLM_DAILY_SPEND_CAP=50.0                     # Daily spend cap in USD
# LLM_DAILY_REQUEST_CAP=1000                   # Daily request cap
# LLM_CB_FAILURE_THRESHOLD=5                   # Circuit breaker failure threshold
# LLM_CB_COOLDOWN_SECONDS=300                  # Circuit breaker cooldown


# ============================================================================
# API Keys — Blockchain Services
# ============================================================================

# Premium RPC provider
# INFURA_API_KEY=your-infura-api-key

# CoinGecko (token price lookups)
# COINGECKO_API_KEY=your-coingecko-api-key

# Block explorer API keys (used by bytecode collection scripts)
# ETHERSCAN_API_KEY=your-etherscan-api-key
# POLYGONSCAN_API_KEY=your-polygonscan-api-key
# ARBISCAN_API_KEY=your-arbiscan-api-key
# BSCSCAN_API_KEY=your-bscscan-api-key

# Twitter/X verification (exploit tracking)
# TWITTER_BEARER_TOKEN=your-twitter-bearer-token


# ============================================================================
# Feature Flags
# ============================================================================

# Enable transaction graph analysis (Neo4j)
GRAPH_ENABLED=true

# Enable ML-based anomaly detection
ML_DETECTION_ENABLED=true

# Enable continuous model retraining on new data
CONTINUOUS_LEARNING_ENABLED=true

# Enable request logging middleware (default: true)
ENABLE_REQUEST_LOGGING=true

# Enable runtime security plane (simulation-based prediction)
# RUNTIME_ENABLED=false

# Auto-start contract scanner on worker boot
# AUTO_START_SCANNER=false
# SCANNER_CHAINS=ethereum,polygon,arbitrum


# ============================================================================
# Worker Settings
# ============================================================================

# Process type: api or worker (used by entrypoint.sh in Docker)
# PROC_TYPE=api

# How often the worker polls for new blocks (seconds)
POLL_INTERVAL_SECONDS=2.0

# Number of transactions to process per batch
BATCH_SIZE=10

# Timeout for processing a single transaction (seconds)
PROCESSING_TIMEOUT_SECONDS=5.0

# Worker health check port (also accepts PORT env var)
# WORKER_HEALTH_PORT=8081

# Heartbeat logging interval (seconds)
# HEARTBEAT_INTERVAL=60

# Optional: restrict worker to specific chains (comma-separated)
# WORKER_CHAINS=ethereum,polygon,arbitrum

# Worker metrics endpoint (for API to query)
# WORKER_METRICS_URL=http://worker:8081/metrics


# ============================================================================
# ML / AI Configuration
# ============================================================================

# ML model type: mlp, cnn, transformer, ensemble, random_forest
# ML_MODEL_TYPE=transformer

# ML inference device: auto, cpu, cuda, mps
# ML_DEVICE=auto

# Path to pre-trained threat detector model
# ML_MODEL_PATH=data/models/threat_detector.pt

# GCS bucket for ML model artifacts
# ML_MODEL_BUCKET=web3-xdr-ml-models

# Vertex AI managed inference endpoint
# VERTEX_AI_ENDPOINT=your-vertex-endpoint

# Model serving path (serving/serve.py container)
# MODEL_PATH=/app/model/model.pt


# ============================================================================
# GCP Settings
# ============================================================================

# GCP project and region (for Vertex AI, Cloud SQL, logging)
# GCP_PROJECT=web3-xdr
# GCP_REGION=us-central1


# ============================================================================
# Graph Database (Neo4j)
# ============================================================================

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE=neo4j


# ============================================================================
# Runtime Security / Simulation
# ============================================================================

# Mempool source: bloxroute, rpc, pseudo (default: pseudo)
# MEMPOOL_SOURCE=pseudo

# bloXroute Cloud-API authorization header
# BLOXROUTE_AUTH_HEADER=your-bloxroute-auth-header

# Comma-separated addresses to monitor in mempool
# BLOXROUTE_MONITORED_ADDRESSES=0x...,0x...

# bloXroute chain ID
# BLOXROUTE_CHAIN_ID=ethereum

# Enable mempool alerting (default: true when bloXroute is configured)
# MEMPOOL_ALERTING_ENABLED=true

# Runtime auto-action (pause contract on threat detection)
# RUNTIME_AUTO_ACTION_ENABLED=false
# RUNTIME_AUTO_ACTION_MIN_CONFIDENCE=0.95
# RUNTIME_ACTION_COOLDOWN_SECONDS=3600

# Per-chain and per-protocol simulation budgets (max simulations/minute)
# RUNTIME_PER_CHAIN_SIM_BUDGET=60
# RUNTIME_PER_PROTOCOL_SIM_BUDGET=20

# Comma-separated list of critical contract addresses for priority simulation
# RUNTIME_CRITICAL_CONTRACTS=0x...,0x...


# ============================================================================
# Guardian / Response
# ============================================================================

# Signer type: local, kms
# SIGNER_TYPE=local
# GUARDIAN_PRIVATE_KEY=your-guardian-private-key

# Cloud KMS signing (GCP/AWS)
# KMS_KEY_ID=your-kms-key-id
# KMS_PROVIDER=gcp
# KMS_REGION=us-central1


# ============================================================================
# Correlation & Detection Rules
# ============================================================================

# Cross-chain correlation
# CORRELATION_WINDOW_MINUTES=30
# AMOUNT_TOLERANCE_PERCENT=0.1
# ORPHAN_CHECK_DELAY_SECONDS=60
# MIN_ALERT_AMOUNT_USD=10000

# Rule feedback loop (auto-suppress noisy rules)
# FEEDBACK_WINDOW_HOURS=168
# FEEDBACK_FP_THRESHOLD=0.80
# FEEDBACK_MIN_SAMPLES=5
# FEEDBACK_AUTO_DISABLE_FP=0.95
# FEEDBACK_COOLDOWN_HOURS=24

# Rule tuner (LLM-based rule adjustment)
# RULE_TUNER_INTERVAL_HOURS=24
# RULE_TUNER_AUTO_APPLY=false

# Spike detection
# SPIKE_WINDOW_SECONDS=300
# SPIKE_THRESHOLD=20
# SPIKE_COOLDOWN_SECONDS=900


# ============================================================================
# Data Retention
# ============================================================================

# EVENT_RETENTION_DAYS=90
# INCIDENT_RETENTION_DAYS=365
# RETENTION_INTERVAL_HOURS=6


# ============================================================================
# Queue / Event Bus (Redis Streams)
# ============================================================================

# QUEUE_MAX_SIZE=10000
# QUEUE_DROP_POLICY=never                      # never, oldest, low_severity
# DLQ_MAX_SIZE=1000
# PENDING_RECOVERY_INTERVAL=300
# MAX_RETRIES=3


# ============================================================================
# Telemetry / OpenTelemetry
# ============================================================================

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=sentinel3
# OTEL_TRACES_SAMPLER_ARG=1.0
# APP_VERSION=2.0.0


# ============================================================================
# Verification
# ============================================================================

# Sentinel3 API endpoint for exploit tracker
# SENTINEL3_API=http://localhost:8000


# ============================================================================
# App Settings
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment name: development, staging, production
ENVIRONMENT=development

# Server port (Cloud Run sets this automatically)
# PORT=8080

# Debug mode (enables verbose logging)
# DEBUG=false

# Uvicorn worker count (default: 1)
# UVICORN_WORKERS=1

# ENV alias (used by settings module)
# ENV=development


# ============================================================================
# Monitoring & Admin UIs (Docker Compose only)
# ============================================================================

# pgAdmin login email
PGADMIN_EMAIL=admin@xdr.local

# pgAdmin login password
PGADMIN_PASSWORD=your-pgadmin-password

# Grafana admin password
GRAFANA_PASSWORD=your-grafana-password
