# ============================================================================
# Web3 XDR - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ============================================================================

# --------------------------------------------------------------------------
# PostgreSQL Database
# --------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xdr
POSTGRES_PASSWORD=xdr_password
POSTGRES_DB=web3_xdr

# Enable/disable PostgreSQL persistence (set to false for in-memory only)
POSTGRES_ENABLED=true

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_BATCH_SIZE=100

# --------------------------------------------------------------------------
# RPC Endpoints (get free keys from providers)
# --------------------------------------------------------------------------

# Infura (https://infura.io)
INFURA_API_KEY=your_infura_api_key_here

# Or specify full URLs:
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY

# Solana RPC (https://www.quicknode.com or https://helius.dev)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --------------------------------------------------------------------------
# Alerting (Optional)
# --------------------------------------------------------------------------

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# PagerDuty Integration Key
PAGERDUTY_INTEGRATION_KEY=

# --------------------------------------------------------------------------
# Application Settings
# --------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
SQL_ECHO=false

# --------------------------------------------------------------------------
# Monitoring (pgAdmin, Grafana)
# --------------------------------------------------------------------------
PGADMIN_EMAIL=admin@xdr.local
PGADMIN_PASSWORD=admin
GRAFANA_PASSWORD=admin

# --------------------------------------------------------------------------
# Redis (for caching)
# --------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
