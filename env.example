# ============================================================================
# Web3 XDR - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ============================================================================

# --------------------------------------------------------------------------
# PostgreSQL Database
# --------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xdr
POSTGRES_PASSWORD=xdr_password
POSTGRES_DB=web3_xdr

# Enable/disable PostgreSQL persistence (set to false for in-memory only)
POSTGRES_ENABLED=true

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_BATCH_SIZE=100

# --------------------------------------------------------------------------
# RPC Endpoints (get free keys from providers)
# --------------------------------------------------------------------------

# Infura (https://infura.io)
INFURA_API_KEY=your_infura_api_key_here

# Or specify full URLs:
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY

# Solana RPC (https://www.quicknode.com or https://helius.dev)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --------------------------------------------------------------------------
# Alerting (Optional)
# --------------------------------------------------------------------------

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# PagerDuty Integration Key
PAGERDUTY_INTEGRATION_KEY=

# --------------------------------------------------------------------------
# Application Settings
# --------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
SQL_ECHO=false

# --------------------------------------------------------------------------
# Monitoring (pgAdmin, Grafana)
# --------------------------------------------------------------------------
PGADMIN_EMAIL=admin@xdr.local
PGADMIN_PASSWORD=admin
GRAFANA_PASSWORD=admin

# --------------------------------------------------------------------------
# Redis (for caching)
# --------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# ML Contract Scanner
# --------------------------------------------------------------------------
# Model type for bytecode classification:
#   - transformer (default): Highest accuracy, attention-based (requires GPU)
#   - ensemble: Combines MLP + CNN for robust predictions
#   - cnn: Fast pattern detection in opcode sequences
#   - mlp: Fastest, feature-based classification
#   - random_forest: Sklearn RandomForest (no GPU required)
ML_MODEL_TYPE=transformer

# Device for ML inference (auto, cuda, mps, cpu)
#   - auto (default): Automatically selects best available (CUDA > MPS > CPU)
#   - cuda: Force NVIDIA GPU (requires CUDA)
#   - mps: Force Apple Silicon GPU (Metal Performance Shaders)
#   - cpu: Force CPU only
ML_DEVICE=auto

# --------------------------------------------------------------------------
# Runtime Security Plane
# --------------------------------------------------------------------------
# Enable Runtime Security Plane (simulation-based prediction)
RUNTIME_ENABLED=false

# Mempool source: "bloxroute" or "pseudo" (default: pseudo)
MEMPOOL_SOURCE=pseudo

# bloXroute Cloud-API Authorization Header
# Get from: https://bloxroute.com/
BLOXROUTE_AUTH_HEADER=

# Runtime auto-action settings (default: false - safe)
RUNTIME_AUTO_ACTION_ENABLED=false
RUNTIME_AUTO_ACTION_MIN_CONFIDENCE=0.95
RUNTIME_ACTION_COOLDOWN_SECONDS=3600

# Runtime simulation budgets
RUNTIME_PER_CHAIN_SIM_BUDGET=60
RUNTIME_PER_PROTOCOL_SIM_BUDGET=20

# Critical contracts to monitor (comma-separated addresses)
RUNTIME_CRITICAL_CONTRACTS=
